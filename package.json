{
  "name": "joowon-custom-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#local-runtime": {
      "workerd": "./src/workers/local-runtime.ts",
      "default": "./src/local-runtime.ts"
    }
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "sandbox": "bun run scripts/sandbox-server.ts",
    "sandbox:check": "bun run scripts/sandbox-walkthrough.ts",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json && biome check .",
    "test": "bun test tests",
    "dev:worker": "wrangler dev",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "test:workers": "pnpm run build:worker && node --experimental-strip-types --test workers-tests/integration.mts workers-tests/alarm.mts",
    "deploy:worker": "wrangler deploy",
    "setup:worker-secrets": "bun run scripts/worker-secrets.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "cheerio": "^1.1.2",
    "ky": "^1.14.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/bun": "^1.3.0",
    "@types/node": "24.13.2",
    "miniflare": "5.20261103.0-beta",
    "typescript": "^5.9.3",
    "wrangler": "4.157.0"
  }
}
