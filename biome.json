{
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "workers-tests/**",
      "*.json",
      "!tests/fixtures"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error"
      }
    }
  }
}
